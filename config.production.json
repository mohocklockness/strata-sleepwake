{
  "poll_interval_s": 5,
  "idle_refresh_s": 1,
  "idle_grace_s": 5,
  "countdown_s": 30,
  "idle_timeout_s": 600,
  "final_idle_slack_s": 2.0,
  "suspend_timeout_s": 600,
  "suspend_resume_wait_s": 120,
  "log_dir": "/var/log/sleepmgr",
  "log_max_bytes": 10485760,
  "log_backups": 5,
  "pause": {
    "state_file": "/var/lib/sleepmgr/state.json",
    "socket": "/run/sleepmgr/control.sock",
    "inhibitor": true,
    "timed_default_s": 3600,
    "allow_uids": [
      0,
      1000
    ],
    "group": "sleepuser"
  },
  "service": {
    "lock_file": "/run/sleepmgr/monitor.lock",
    "status_file": "/run/sleepmgr/status.json",
    "allow_unattended_suspend": false,
    "stale_status_s": 15,
    "gnome_check_s": 300
  },
  "gate": {
    "enabled": false,
    "socket": "/run/sleepmgr-gate/gate.sock",
    "port": 8080,
    "allow_uid": 1000,
    "token_file": "/etc/sleepmgr/gate.token",
    "timeout_s": 3,
    "settle_s": 10.0,
    "verify_s": 5.0,
    "verify_probes": 3,
    "lease_ttl_s": 900,
    "startup_recovery_timeout_s": 180,
    "startup_recovery_interval_s": 2
  },
  "strata": {
    "enabled": true,
    "config_path": "/srv/strata/Strata/strata-iq2_xs.json",
    "server_cmdline_substrings": [
      "Strata/serve/server.py"
    ],
    "engine_cmdline_substrings": [
      "Strata/engine/strata"
    ],
    "gpu_util_threshold": 5,
    "gpu_consecutive": 2,
    "http_timeout_s": 3,
    "status_failures_before_unknown": 2,
    "unload_wait_s": 300,
    "unload_verify_s": 90,
    "recovery_timeout_s": 180,
    "load_request_timeout_s": 120,
    "load_retry_interval_s": 2,
    "readiness_deadline_s": 300
  },
  "opencode": {
    "enabled": true,
    "db_path": "/home/sleepuser/.local/share/opencode/opencode.db",
    "processes": [
      {
        "name": "opencode-cli"
      },
      {
        "name": "ai.opencode.desktop"
      }
    ],
    "tool_processes": [
      "bash",
      "sh",
      "dash",
      "python3",
      "node",
      "npm",
      "git",
      "rg",
      "fd",
      "sed",
      "awk",
      "grep",
      "make",
      "cargo",
      "go",
      "pip",
      "pip3",
      "apt",
      "apt-get",
      "dpkg",
      "curl",
      "wget",
      "ffmpeg",
      "yt-dlp"
    ],
    "cpu_threshold_pct": 2.0,
    "cpu_consecutive": 2,
    "net_threshold_bytes_s": 20000,
    "net_consecutive": 2,
    "socket_activity_ms": 5000,
    "active_window_s": 90,
    "pending_window_s": 600
  },
  "updates": {
    "processes": [
      {
        "name": "apt",
        "args_any": []
      },
      {
        "name": "apt-get",
        "args_any": []
      },
      {
        "name": "aptitude"
      },
      {
        "name": "dpkg"
      },
      {
        "name": "unattended-upgrade"
      },
      {
        "name": "snap",
        "args_any": [
          "install",
          "refresh",
          "remove",
          "revert",
          "download",
          "switch"
        ]
      },
      {
        "name": "pip",
        "args_any": [
          "install",
          "uninstall",
          "download"
        ]
      },
      {
        "name": "pip3",
        "args_any": [
          "install",
          "uninstall",
          "download"
        ]
      },
      {
        "name": "npm",
        "args_any": [
          "install",
          "i",
          "ci",
          "update",
          "uninstall"
        ]
      },
      {
        "name": "fwupdmgr",
        "args_any": [
          "update",
          "install"
        ]
      },
      {
        "name": "ubuntu-drivers"
      }
    ],
    "units": [
      "apt-daily.service",
      "apt-daily-upgrade.service",
      "fwupd-refresh.service"
    ],
    "idle_units": [
      "packagekit.service"
    ]
  },
  "transfers": {
    "processes": [
      {
        "name": "rsync"
      },
      {
        "name": "scp"
      },
      {
        "name": "sftp"
      },
      {
        "name": "rclone"
      },
      {
        "name": "lftp"
      },
      {
        "name": "aria2c"
      },
      {
        "name": "wget"
      },
      {
        "name": "curl"
      },
      {
        "name": "transmission-daemon"
      },
      {
        "name": "transmission-gtk"
      },
      {
        "name": "qbittorrent"
      },
      {
        "name": "deluged"
      },
      {
        "name": "nzbget"
      },
      {
        "name": "yt-dlp"
      }
    ],
    "net_ifaces": [
      "eth0",
      "wlan0"
    ],
    "net_mbps_threshold": 2.0,
    "net_consecutive": 3,
    "disk_write_mbps_threshold": 8.0,
    "disk_devices": [
      "sda",
      "nvme0n1"
    ],
    "disk_consecutive": 3
  },
  "streams": {
    "enabled": true,
    "ports": [
      47984,
      47989,
      48010
    ],
    "log_path": "/home/sleepuser/.config/sunshine/sunshine.log"
  },
  "suspend_guard": {
    "allow_uids": [
      0,
      1000
    ],
    "command_timeout_s": 15.0,
    "enabled": true,
    "gpu_timeout_s": 3.0,
    "group": "sleepuser",
    "max_gpu_memory_mib": 512,
    "max_gpu_util_pct": 5,
    "max_release_ttl_s": 120.0,
    "min_available_ram_mib": 4096,
    "poll_s": 3.0,
    "release_ttl_s": 30.0,
    "require_gate": true,
    "require_token": true,
    "socket": "/run/sleepmgr-suspend-guard/guard.sock",
    "status_file": "/run/sleepmgr-suspend-guard/status.json",
    "token_file": "/etc/sleepmgr/suspend-guard.token"
  }
}
